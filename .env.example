# Copie ce fichier en .env.local puis remplis les valeurs.

# Coach IA (gratuit) : crée une clé sur https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optionnel : modèle Gemini (par défaut : gemini-flash-latest)
GEMINI_MODEL=

# Comptes en ligne (gratuit) : https://supabase.com > ton projet > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
